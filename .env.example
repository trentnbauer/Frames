# Copy to .env (never commit .env).

# Run a published release instead of building from source. Pin an exact version to control
# when you upgrade. Leave commented to build from this folder.
# FRAMES_IMAGE=ghcr.io/trentnbauer/frames:1.0.0

# Folder with your photographs. Mounted read-only.
PHOTOS_DIR=/path/to/your/photos

# Where to listen. 127.0.0.1 = this machine only. Use 0.0.0.0 to reach it from other
# devices, and set AUTH_PASSWORD first.
BIND_ADDRESS=127.0.0.1
PORT=3000

# Optional shared password (HTTP Basic). Leave AUTH_PASSWORD empty for none.
# For sign-in with Google, GitHub, Microsoft or your own OpenID Connect server, use Settings, Sign-in & access in the app.
AUTH_USER=frames
AUTH_PASSWORD=

# Only if a reverse proxy rewrites the Host header, for example: frames.example.com
ALLOWED_HOSTS=

# false stops new people getting an account the first time they sign in (anyone allowed in who already has
# one, and anyone an administrator added by email, still can). true (the default) lets them.
ALLOW_SIGNUPS=true

# Outgoing email (SMTP), for sign-in codes, invites, share links and reminders. Everything here can also be set in Settings, Email; what
# is saved in the app wins. Email sign-in is offered only while the connection passes its health check. Leave empty for no email.
SMTP_HOST=
SMTP_PORT=587
# true = secure from the start (usually port 465); false = STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Frames

# Settings, Env file exports every setting and secret as one file to use here. It sets ALLOW_ENV_EXPORT=false so the secrets
# cannot be downloaded a second time; set it to true and restart to export again. true only allows it: the export is also off until an
# administrator turns on "Allow exporting the env file" in Settings, Env file (it asks them to sign in again). The file also holds every setting as its own
# variable (SHARED_AI_1_ENDPOINT, SHARED_AI_1_KEY, AUTH_1_CLIENT_ID, AUTH_1_KEY, AUTH_ALLOW and so on): use it as frames.env (the compose file reads it).
ALLOW_ENV_EXPORT=true

# Encrypts every API key, client secret and token Frames stores (16 characters or more). Keep it outside the data volume. Empty: Frames keeps
# a random key in secret.key in the data folder instead. If it is lost or changed, the saved secrets cannot be read and you enter them again.
FRAMES_SECRET_KEY=

# true when Frames sits behind a reverse proxy (so share links rate-limit each visitor, not the proxy).
TRUST_PROXY=false

# Largest single photo you can upload, in MB (default 2048).
MAX_UPLOAD_MB=

# true switches the Cloudflare Turnstile bot check off (sign-in page and share links). Use it to get back in if a wrong site key stops the check from
# showing. The keys themselves are set in Settings, Sign-in & access.
TURNSTILE_DISABLE=
# The bot check is not asked for the first five minutes after Frames starts or restarts (as long as the emergency login lasts), so a wrong key can never block you
# just after a start. Seconds to wait instead; 0 = no wait.
TURNSTILE_DELAY_SECONDS=

# Folder on the Docker host for the daily whole-server backup (people and libraries, no photographs, no server settings). Default ./backups.
# Settings, Backup restores from it. Keep it somewhere other than the data volume.
BACKUPS_DIR=

# true switches ALL sign-in inside Frames off: for one person behind something else that protects it (Cloudflare
# Access, a VPN), or to get back in when sign-in is misconfigured. Anyone who can reach the port can then use Frames.
AUTH_DISABLE=false

# Each start, Frames makes a temporary administrator for when nobody can sign in, and writes its username and password to the
# server log. It works once, for five minutes, and is deleted if unused or when signed out of. false makes none.
EMERGENCY_LOGIN=true

# true only if your OpenID Connect server is on plain http:// on a network you trust.
OIDC_ALLOW_HTTP=false

# Optional: reach Frames from outside through a Cloudflare tunnel you made in the Cloudflare dashboard. Paste its token here
# (or in Settings, Cloudflare tunnel); with APP_HOSTNAME and PORTFOLIO_HOSTNAME below it pre-fills the settings.
TUNNEL_TOKEN=

# Optional instead: let Frames set the tunnel up itself through the Cloudflare API, with a login in front of the app (README, Cloudflare tunnel).
# Make the API token at https://dash.cloudflare.com/profile/api-tokens (Create Custom Token) with
# Account > Cloudflare Tunnel: Edit, Account > Access: Apps and Policies: Edit,
# Zone > DNS: Edit and Zone > Zone: Read. The steps for the simple tunnel are in the README, Cloudflare tunnel.
# Leave all of these empty to run without a tunnel.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
TUNNEL_NAME=Frames
# The app, for example frames.example.com. Only reachable through Cloudflare Access, which lets in ACCESS_EMAILS.
APP_HOSTNAME=
ACCESS_EMAILS=
# The public portfolio, for example gallery.example.com. Shows only the portfolio and needs no login.
PORTFOLIO_HOSTNAME=

# How many days a sign-in lasts (default 14).
SESSION_DAYS=
