# Copy to .env if you want to override compose defaults.
PORT=4000

# Optional: seeds vision providers on boot so photo auto-tagging works
# without a manual Settings-UI step. Each provider is only created if its
# required field is set; leave unset to skip that provider entirely. Re-applied
# every boot — edits made to these providers in the Settings UI are overwritten
# on restart (manually-added providers with different names are unaffected).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
# SELF_HOSTED_BASE_URL=http://localhost:11434/v1
# SELF_HOSTED_API_KEY=
# SELF_HOSTED_MODEL=llava

# Optional: public app credentials (not secrets) for the Google Drive /
# Dropbox import buttons. Exposed to the browser via GET /api/config.
# GOOGLE_API_KEY=
# GOOGLE_CLIENT_ID=
# DROPBOX_APP_KEY=

# Optional: default social handles/links shown in the bottom-left corner of
# a zine's back cover (comma-separated). Settings > Social handles overrides
# this per-browser; either way it's a per-export tick box, never forced on.
# SOCIAL_HANDLES=@yourhandle, yoursite.com
