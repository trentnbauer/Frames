# Copy to .env (never commit .env).

# Run a published release instead of building from source. Pin an exact version to control
# when you upgrade. Leave commented to build from this folder.
# FRAMES_IMAGE=ghcr.io/trentnbauer/frames:1.0.0

# Folder with your photographs. Mounted read-only.
PHOTOS_DIR=/path/to/your/photos

# Where to listen. 127.0.0.1 = this machine only. Use 0.0.0.0 to reach it from other
# devices, and set AUTH_PASSWORD first.
BIND_ADDRESS=127.0.0.1
PORT=3000

# Login (HTTP Basic). Leave AUTH_PASSWORD empty for no login.
AUTH_USER=frames
AUTH_PASSWORD=

# Only if a reverse proxy rewrites the Host header, for example: frames.example.com
ALLOWED_HOSTS=

# Set to 1 when Frames sits behind a reverse proxy (so share links rate-limit each visitor, not the proxy).
TRUST_PROXY=

# Largest single photo you can upload, in MB (default 2048).
MAX_UPLOAD_MB=
